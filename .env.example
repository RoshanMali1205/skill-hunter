# Copy this file to .env for local `npm start` / `netlify dev` testing
# (never commit the real .env — and never put a real key in this example file).
# In production (Netlify), set these under Site configuration > Environment variables instead.

# Required for AI Mentor replies — get a free key at https://aistudio.google.com
GEMINI_API_KEY=
AI_MODEL=gemini-flash-latest

# Required — without this the AI Mentor endpoint returns 503 (fail closed).
# Must exactly match the APP_SHARED_TOKEN constant in
# src/app/core/services/ai-assistant.service.ts — it's a bot deterrent, not a
# real secret (it ships in the built JS bundle), so any string is fine.
APP_SHARED_TOKEN=OmFrAQPhkXtNYAdLfC35UCP--Th-sEVY
